#!/bin/bash
set -euo pipefail

# Where this script lives, so that `install` works from any directory.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Uninstall must only ever remove things we installed. Everything we do to the
# machine is recorded here so that a later `uninstall` can tell our packages
# apart from ones the user already had.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/linuxify"
INSTALLED_FORMULAS="$STATE_DIR/installed-formulas"

# One directory holds everything we own, rather than scattering dotfiles across
# $HOME. Respect XDG_CONFIG_HOME: users are entitled to move it.
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/linuxify"

# The single line ~/.zshrc needs. Kept unexpanded on purpose, so that it still
# resolves correctly for a user who sets XDG_CONFIG_HOME later.
# shellcheck disable=SC2016
ZSHRC_LINE='source "${XDG_CONFIG_HOME:-$HOME/.config}/linuxify/zsh-integration.zsh"'

linuxify_check_os() {
    if ! [[ "$OSTYPE" =~ darwin* ]]; then
        echo "This is meant to be run on macOS only" >&2
        exit 1
    fi
}

linuxify_check_brew() {
    if ! command -v brew > /dev/null; then
        echo "Homebrew not installed!" >&2
        echo "In order to use this script please install homebrew from https://brew.sh" >&2
        exit 1
    fi
}

linuxify_set_prefix() {
    BREW_PREFIX="$(brew --prefix)"
    export BREW_PREFIX
}

linuxify_check_dirs() {
    local result=0
    local dir

    for dir in "${BREW_PREFIX}/bin" "${BREW_PREFIX}/sbin"; do
        if [[ ! -d $dir || ! -w $dir ]]; then
            echo "$dir must exist and be writeable" >&2
            result=1
        fi
    done

    return $result
}

linuxify_formulas=(
    # GNU programs non-existing in macOS
    "watch"
    "wget"
    "wdiff"
    "autoconf"

    # GNU programs whose BSD counterpart is installed in macOS
    "coreutils"
    "diffutils"
    "ed"
    "findutils"
    "gawk"
    "gnu-indent"
    "gnu-sed"
    "gnu-tar"
    "gnu-which"
    "grep"
    "gzip"
    "screen"

    # GNU programs existing in macOS which are outdated
    "bash"
    "emacs"
    "gpatch"
    "less"
    "m4"
    "make"
    "nano"
    "bison"

    # BSD programs existing in macOS which are outdated
    "flex"

    # Other common/preferred programs in GNU/Linux distributions
    "libressl"
    "file-formula"
    "git"
    "openssh"
    "perl"
    "python"
    "rsync"
    "unzip"
    "vim"
    "htop"
    "tree"
    "xz"
    "zstd"

    # Colored/decompressing output and shell niceties
    "lesspipe"
    "fastfetch"
    "zsh-autosuggestions"
    "zsh-syntax-highlighting"
)

# Note a formula we installed ourselves, so uninstall knows it may remove it.
linuxify_record_formula() {
    local formula="$1"

    mkdir -p "$STATE_DIR"
    if [ -f "$INSTALLED_FORMULAS" ] && grep -qxF -- "$formula" "$INSTALLED_FORMULAS"; then
        return 0
    fi

    echo "$formula" >> "$INSTALLED_FORMULAS"
}

linuxify_forget_formula() {
    local formula="$1"
    local tmp

    [ -f "$INSTALLED_FORMULAS" ] || return 0

    tmp="$(mktemp)"
    grep -vxF -- "$formula" "$INSTALLED_FORMULAS" > "$tmp" || true
    cat "$tmp" > "$INSTALLED_FORMULAS"
    rm -f "$tmp"
}

# True only for formulas this script installed. A formula the user already had
# is not ours to remove, however GNU it happens to be.
linuxify_owns_formula() {
    local formula="$1"

    [ -f "$INSTALLED_FORMULAS" ] && grep -qxF -- "$formula" "$INSTALLED_FORMULAS"
}

# Keep a pristine copy of a config file before we edit it for the first time.
linuxify_backup() {
    local file="$1"

    if [ -f "$file" ] && [ ! -f "$file.linuxify.bak" ]; then
        cp "$file" "$file.linuxify.bak"
    fi
}

# Append a line to a shell config file unless it is already present.
linuxify_add_line() {
    local file="$1"
    local line="$2"

    if [ -f "$file" ] && grep -qxF -- "$line" "$file"; then
        return 0
    fi

    echo "$line" >> "$file"
}

# Remove a line by exact match. Matching is on fixed strings rather than a
# regex so that the dots and braces in the line we add to ~/.zshrc cannot act
# as wildcards and take a neighbouring line with them.
linuxify_remove_line() {
    local file="$1"
    local line="$2"
    local tmp

    [ -f "$file" ] || return 0

    tmp="$(mktemp)"
    grep -vxF -- "$line" "$file" > "$tmp" || true
    # Copy rather than move, so the file keeps its inode and permissions.
    cat "$tmp" > "$file"
    rm -f "$tmp"
}

# Uninstall a formula, but never at the cost of something else the user has
# installed. Several of our formulas (zstd, xz, python, perl, ...) are also
# dependencies of unrelated packages, and brew rightly refuses to remove those.
# A refusal must not abort the whole uninstall, so failures are reported and
# skipped rather than propagated.
linuxify_uninstall_formula() {
    local formula="$1"
    local dependents

    if ! linuxify_owns_formula "$formula"; then
        return 0
    fi

    if ! brew ls --versions "$formula" > /dev/null 2>&1; then
        linuxify_forget_formula "$formula"
        return 0
    fi

    # Last line of defence for anyone who pointed their login shell at one of
    # our formulas by hand: never delete the shell out from under them.
    if [ "${SHELL:-}" = "${BREW_PREFIX}/bin/${formula}" ]; then
        echo "Keeping $formula, it is your current login shell"
        return 0
    fi

    dependents=$(brew uses --installed --formula "$formula" 2>/dev/null | grep -vxF -- "$formula" || true)
    if [ -n "$dependents" ]; then
        echo "Keeping $formula, still required by: $(echo "$dependents" | tr '\n' ' ')"
        return 0
    fi

    if brew uninstall "$formula"; then
        linuxify_forget_formula "$formula"
    else
        echo "Could not uninstall $formula, skipping"
    fi
}

linuxify_install() {
    linuxify_check_os
    linuxify_check_brew
    linuxify_set_prefix
    linuxify_check_dirs

    local formula

    # Install all formulas, remembering the ones that were not already here.
    for formula in "${linuxify_formulas[@]}"; do
        if brew ls --versions "$formula" > /dev/null 2>&1; then
            echo "Found existing $formula, leaving it alone"
        else
            echo "Installing $formula"
            brew install "$formula"
            linuxify_record_formula "$formula"
        fi
    done

    mkdir -p "$CONFIG_DIR"

    # PATH/MANPATH/INFOPATH, and colored output for ls/grep/diff and friends
    linuxify_backup "$CONFIG_DIR/environment.sh"
    install -m 0644 "$SCRIPT_DIR/environment.sh" "$CONFIG_DIR/environment.sh"

    # Prompt, colored man pages, fetch banner, zsh plugins. Sources
    # environment.sh itself, so ~/.zshrc only needs the one line.
    linuxify_backup "$CONFIG_DIR/zsh-integration.zsh"
    install -m 0644 "$SCRIPT_DIR/zsh-integration.zsh" "$CONFIG_DIR/zsh-integration.zsh"

    linuxify_backup ~/.zshrc
    linuxify_add_line ~/.zshrc "$ZSHRC_LINE"
    echo "Installed to $CONFIG_DIR and sourced from your ~/.zshrc"
    echo "If you use bash, add this to your ~/.bashrc as well:"
    echo "  source \"\${XDG_CONFIG_HOME:-\$HOME/.config}/linuxify/environment.sh\""
}

linuxify_uninstall() {
    linuxify_check_os
    linuxify_check_brew
    linuxify_set_prefix

    local i file

    # Uninstall in reverse order, and only what we installed in the first place
    for (( i=${#linuxify_formulas[@]}-1; i>=0; i-- )); do
        linuxify_uninstall_formula "${linuxify_formulas[i]}"
    done

    # Restore whatever was at these paths before we arrived, if anything
    for file in "$CONFIG_DIR/environment.sh" "$CONFIG_DIR/zsh-integration.zsh"; do
        rm -f "$file"
        if [ -f "$file.linuxify.bak" ]; then
            mv "$file.linuxify.bak" "$file"
        fi
    done
    # Only if we left nothing of the user's behind
    rmdir "$CONFIG_DIR" 2>/dev/null || true

    linuxify_remove_line ~/.zshrc "$ZSHRC_LINE"

    if [ -f "$INSTALLED_FORMULAS" ] && [ ! -s "$INSTALLED_FORMULAS" ]; then
        rm -f "$INSTALLED_FORMULAS"
        rmdir "$STATE_DIR" 2>/dev/null || true
    fi

    echo "If you use bash, remove the linuxify line from your ~/.bashrc too"
    if [ -f ~/.zshrc.linuxify.bak ]; then
        echo "Your pre-install ~/.zshrc is still at ~/.zshrc.linuxify.bak; delete it when you are happy"
    fi
    if [ -f "$INSTALLED_FORMULAS" ]; then
        echo "Some formulas were kept and are still listed in $INSTALLED_FORMULAS"
    fi
}

linuxify_info() {
    linuxify_check_os
    linuxify_check_brew

    local formula

    for formula in "${linuxify_formulas[@]}"; do
        brew info "$formula"
        printf "\n\n===============================================================================================================================\n\n"
    done
}

linuxify_help() {
    echo "usage: linuxify [-h] [command]"
    echo ""
    echo "valid commands:"
    echo "  install    install GNU/Linux utilities"
    echo "  uninstall  uninstall GNU/Linux utilities"
    echo "  info       show info on GNU/Linux utilities"
    echo ""
    echo "optional arguments:"
    echo "  -h, --help  show this help message and exit"
}

linuxify_main() {
    if [ $# -ne 1 ]; then
        linuxify_help >&2
        exit 2
    fi

    case $1 in
        "install") linuxify_install ;;
        "uninstall") linuxify_uninstall ;;
        "info") linuxify_info ;;
        "-h" | "--help") linuxify_help ;;
        *)
            echo "unknown command: $1" >&2
            linuxify_help >&2
            exit 2
            ;;
    esac
}

linuxify_main "$@"
